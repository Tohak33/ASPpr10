@model para.Models.ErrorViewModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="container mt-5 pt-5 text-center">
    <h1 class="text-danger display-4">Произошла ошибка</h1>
    <h3 class="text-muted mt-3 mb-4">@ViewBag.ErrorMessage</h3>

    @if (Model != null && Model.ShowRequestId)
    {
        <p class="text-secondary">
            <strong>Идентификатор запроса:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a href="/" class="btn btn-primary mt-4 px-4 py-2">Вернуться на главную страницу</a>
</div>