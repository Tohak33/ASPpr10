@model IEnumerable<para.Models.Product>

@{
    ViewData["Title"] = "Каталог товаров";
    var searchString = Context.Request.Query["searchString"];
    var categoryId = Context.Request.Query["categoryId"];
    var sortOrder = Context.Request.Query["sortOrder"];
    int pageNumber = ViewBag.PageNumber ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<form asp-action="Index" method="get" class="mb-4 bg-light p-3 rounded shadow-sm">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Поиск</label>
            <input type="text" name="searchString" value="@searchString" class="form-control" placeholder="Название товара..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Категория</label>
            <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                <option value="">Все категории</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Сортировка</label>
            <select name="sortOrder" class="form-select">
                <option value="">По умолчанию</option>
                <option value="name_asc" selected="@(sortOrder == "name_asc")">По названию (А-Я)</option>
                <option value="name_desc" selected="@(sortOrder == "name_desc")">По названию (Я-А)</option>
                <option value="price_asc" selected="@(sortOrder == "price_asc")">Сначала дешевле</option>
                <option value="price_desc" selected="@(sortOrder == "price_desc")">Сначала дороже</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Применить</button>
        </div>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@(!string.IsNullOrEmpty(item.ImagePath) ? item.ImagePath : "/images/placeholder.png")" class="card-img-top" alt="@item.ProductName" style="object-fit: contain; height: 200px; padding: 10px;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">@item.ProductName</h5>
                    <p class="text-muted small mb-1">Категория: @item.Category?.CategoryName</p>
                    <p class="card-text flex-grow-1">@item.Description</p>
                    <h4 class="text-primary mb-3">@item.Price.ToString("C")</h4>
                    <form asp-controller="Cart" asp-action="Add" method="post" class="mt-auto">
                        <input type="hidden" name="id" value="@item.ProductID" />
                        <button type="submit" class="btn btn-success w-100">В корзину</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(pageNumber - 1)" asp-route-searchString="@searchString" asp-route-categoryId="@categoryId" asp-route-sortOrder="@sortOrder">Назад</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == pageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchString="@searchString" asp-route-categoryId="@categoryId" asp-route-sortOrder="@sortOrder">@i</a>
                </li>
            }
            <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(pageNumber + 1)" asp-route-searchString="@searchString" asp-route-categoryId="@categoryId" asp-route-sortOrder="@sortOrder">Вперед</a>
            </li>
        </ul>
    </nav>
}