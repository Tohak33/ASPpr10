@model para.Models.Product
@{
    ViewData["Title"] = "Редактировать товар";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mt-4">
    <h2>Редактирование товара</h2>
    <hr class="border-secondary" />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit">
                <input type="hidden" asp-for="ProductID" />
                <div class="mb-3">
                    <label asp-for="ProductName" class="control-label mb-1">Название товара</label>
                    <input asp-for="ProductName" class="form-control bg-dark text-light border-secondary" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="control-label mb-1">Описание</label>
                    <textarea asp-for="Description" class="form-control bg-dark text-light border-secondary" rows="3"></textarea>
                </div>
                <div class="mb-3">
                    <label asp-for="CategoryID" class="control-label mb-1">Категория</label>
                    <select asp-for="CategoryID" class="form-control bg-dark text-light border-secondary" asp-items="ViewBag.CategoryID"></select>
                </div>
                <div class="mb-4">
                    <label asp-for="Price" class="control-label mb-1">Цена</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control bg-dark text-light border-secondary" required />
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-warning px-4 me-2">Сохранить</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>