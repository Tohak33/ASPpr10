@model para.Models.Order
@{
    ViewData["Title"] = "Изменить заказ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Редактирование заказа</h2>
<hr class="border-secondary" />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="OrderID" />
            <div class="mb-3">
                <label asp-for="UserID" class="control-label mb-1">Пользователь</label>
                <select asp-for="UserID" class="form-control bg-dark text-light border-secondary" asp-items="ViewBag.UserID"></select>
            </div>
            <div class="mb-3">
                <label asp-for="OrderDate" class="control-label mb-1">Дата заказа</label>
                <input asp-for="OrderDate" type="date" class="form-control bg-dark text-light border-secondary" />
            </div>
            <div class="mb-4">
                <label asp-for="Status" class="control-label mb-1">Статус</label>
                <input asp-for="Status" class="form-control bg-dark text-light border-secondary" />
            </div>
            <div class="form-group">
                <input type="submit" value="Сохранить" class="btn btn-warning me-2" />
                <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>