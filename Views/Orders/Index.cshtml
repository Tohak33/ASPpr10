@model IEnumerable<para.Models.Order>

@{
    ViewData["Title"] = "Заказы";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-white">Заказы</h2>
    <a asp-action="Create" class="btn btn-primary">Добавить заказ</a>
</div>

<table class="table table-dark table-bordered align-middle">
    <thead>
        <tr>
            <th>Номер заказа</th>
            <th>Пользователь</th>
            <th>Товары</th>
            <th>Дата</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OrderID</td>
                <td>@item.User?.Login</td>
                <td>
                    <ul class="list-unstyled mb-0">
                        @foreach (var oi in item.OrderItems)
                        {
                            <li>@oi.Product?.ProductName (@oi.Quantity шт.)</li>
                        }
                    </ul>
                </td>
                <td>@item.OrderDate</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.OrderID" class="btn btn-warning btn-sm">Изменить</a>
                    <a asp-action="Delete" asp-route-id="@item.OrderID" class="btn btn-danger btn-sm">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>