@model para.Models.Order
@{
    ViewData["Title"] = "Удалить заказ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h3 class="text-danger">Удалить этот заказ?</h3>
<hr class="border-secondary" />
<div>
    <dl class="row">
        <dt class="col-sm-3">Номер заказа</dt>
        <dd class="col-sm-9">@Model.OrderID</dd>
        <dt class="col-sm-3">Статус</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
    <form asp-action="Delete" class="mt-4">
        <input type="hidden" asp-for="OrderID" />
        <input type="submit" value="Удалить" class="btn btn-danger me-2" />
        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
    </form>
</div>