<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Админ Панель</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light">
    <header>
        <nav class="navbar navbar-expand navbar-dark bg-black border-bottom border-secondary mb-4 p-3">
            <div class="container-fluid flex-wrap">
                <span class="navbar-brand mb-0 h1 fw-bold me-4">Admin Panel</span>

                <div class="d-flex flex-grow-1 align-items-center" id="adminNavbar">
                    <ul class="navbar-nav flex-row flex-wrap gap-3 me-auto fs-5">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Index">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Categories" asp-action="Index">Категории</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ProductManager" asp-action="Index">Товары</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Users" asp-action="Index">Пользователи</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Roles" asp-action="Index">Роли</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Orders" asp-action="Index">Заказы</a>
                        </li>
                    </ul>
                    <div class="d-flex ms-auto ms-lg-3 mt-2 mt-lg-0">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light text-nowrap">Вернуться на сайт</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>