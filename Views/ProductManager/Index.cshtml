@model IEnumerable<para.Models.Product>
@{
    ViewData["Title"] = "Управление товарами";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Управление товарами</h2>
        <a asp-action="Create" class="btn btn-primary">Добавить новый товар</a>
    </div>

    <table class="table table-dark table-striped table-bordered align-middle mt-3">
        <thead>
            <tr>
                <th>Название</th>
                <th>Описание</th>
                <th>Категория</th>
                <th>Цена</th>
                <th width="220" class="text-center">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
                    <td>@Html.DisplayFor(modelItem => item.Description)</td>
                    <td>@item.Category?.CategoryName</td>
                    <td>@item.Price.ToString("F2") руб.</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.ProductID" class="btn btn-sm btn-warning">Изменить</a>
                        <a asp-action="Delete" asp-route-id="@item.ProductID" class="btn btn-sm btn-danger">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>