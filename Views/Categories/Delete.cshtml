@model para.Models.Category
@{
    ViewData["Title"] = "Удаление";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h3>Вы уверены, что хотите удалить эту категорию?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Название</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CategoryName)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="CategoryID" />
        <input type="submit" value="Удалить безвозвратно" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>