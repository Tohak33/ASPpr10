@model para.Models.Category
@{
    ViewData["Title"] = "Добавление категории";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Добавление новой категории</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="form-group mb-3">
                <label asp-for="CategoryName" class="control-label">Название категории</label>
                <input asp-for="CategoryName" class="form-control" required />
            </div>
            <div class="form-group">
                <input type="submit" value="Создать" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>