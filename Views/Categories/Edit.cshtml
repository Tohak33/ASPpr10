@model para.Models.Category
@{
    ViewData["Title"] = "Изменить категорию";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mt-4">
    <h2>Редактирование категории</h2>
    <hr class="border-secondary" />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Edit">
                <input type="hidden" asp-for="CategoryID" />
                <div class="mb-4">
                    <label asp-for="CategoryName" class="control-label mb-1">Название категории</label>
                    <input asp-for="CategoryName" class="form-control bg-dark text-light border-secondary" required />
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-warning px-4 me-2">Сохранить</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>