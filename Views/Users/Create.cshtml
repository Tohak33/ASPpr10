@model para.Models.User
@{
    ViewData["Title"] = "Добавить пользователя";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Добавление пользователя</h2>
<hr class="border-secondary" />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="mb-3">
                <label asp-for="Login" class="control-label mb-1">Логин</label>
                <input asp-for="Login" class="form-control bg-dark text-light border-secondary" required />
            </div>
            <div class="mb-3">
                <label asp-for="PasswordHash" class="control-label mb-1">Пароль</label>
                <input asp-for="PasswordHash" type="password" class="form-control bg-dark text-light border-secondary" required />
            </div>
            <div class="mb-4">
                <label asp-for="RoleID" class="control-label mb-1">Роль</label>
                <select asp-for="RoleID" class="form-control bg-dark text-light border-secondary" asp-items="ViewBag.RoleID"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Сохранить" class="btn btn-success me-2" />
                <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>